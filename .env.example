# Database (Neon or Supabase Postgres)
# Use postgresql+asyncpg:// for async engine
DATABASE_URL=postgresql+asyncpg://user:password@host/neondb?ssl=require
# Sync connection for Alembic migrations if needed (psycopg)
DATABASE_URL_SYNC=postgresql+psycopg://user:password@host/neondb?sslmode=require

# App settings
ENVIRONMENT=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# Quota & Safety Limits
MAX_ACTIVE_TRACKERS_PER_USER=5
TRACKING_DURATION_DAYS=14
CHECK_INTERVAL_HOURS=24
MAX_OFFERS_PER_PRODUCT=10
LLM_MAX_CALLS_PER_DAY=50
FIRECRAWL_MAX_CREDITS=100
FETCH_TIMEOUT_SECONDS=15
PER_DOMAIN_MIN_DELAY_SECONDS=2.0

# External Providers (required in later phases)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
FIRECRAWL_API_KEY=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=DealWatch

# Auth (OAuth 2.1 via WorkOS AuthKit / Stytch - Phase 8)
AUTH_JWKS_URL=
AUTH_ISSUER=
AUTH_AUDIENCE=
